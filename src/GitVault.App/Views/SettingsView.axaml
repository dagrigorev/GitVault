<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.SettingsView">
  <StackPanel Spacing="6" MaxWidth="620" HorizontalAlignment="Left">

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings_Language}" />
    <ComboBox ItemsSource="{Binding Languages}"
              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
              MinWidth="240"
              AutomationProperties.Name="{loc:Tr Settings_Language}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings_Theme}" />
    <ComboBox ItemsSource="{Binding Themes}"
              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
              MinWidth="240"
              AutomationProperties.Name="{loc:Tr Settings_Theme}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings_RevealPolicy}" />
    <TextBlock Text="{Binding AutoHideCaption}" />
    <TextBlock Text="{Binding ClipboardClearCaption}" />

    <CheckBox Margin="0,16,0,0"
              IsChecked="{Binding DryRunByDefault, Mode=TwoWay}"
              Content="{loc:Tr Settings_DryRunDefault}" />
    <CheckBox IsChecked="{Binding WatchForChanges, Mode=TwoWay}"
              Content="{loc:Tr Settings_WatchForChanges}" />

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Nav_Logs}" />
    <TextBlock Classes="mono" Text="{Binding LogDirectory}" />
    <Button Command="{Binding OpenLogsFolderCommand}"
            Content="{loc:Tr Settings_OpenLogsFolder}"
            HorizontalAlignment="Left" />

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings_Diagnostics}" />
    <TextBlock TextWrapping="Wrap" Text="{Binding DiagnosticsNote}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Command="{Binding PreviewDiagnosticsCommand}" >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconPreview}" />
              <TextBlock Text="{loc:Tr Settings_PreviewDiagnostics}" />
            </StackPanel>
          </Button>
      <Button Command="{Binding SaveDiagnosticsCommand}"
              IsEnabled="{Binding CanSaveDiagnostics}"
              >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconApply}" />
              <TextBlock Text="{loc:Tr Settings_SaveDiagnostics}" />
            </StackPanel>
          </Button>
    </StackPanel>
    <TextBlock IsVisible="{Binding DiagnosticsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap"
               Text="{Binding DiagnosticsStatus}" />

    <ItemsControl ItemsSource="{Binding DiagnosticsItems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Expander Margin="0,4,0,0" Header="{Binding Name}">
            <StackPanel Spacing="4">
              <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Description}" />
              <SelectableTextBlock Classes="mono" Text="{Binding Content}" />
            </StackPanel>
          </Expander>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Settings_Telemetry}" />
    <TextBlock TextWrapping="Wrap" Text="{Binding TelemetryCaption}" />

  </StackPanel>
</UserControl>
