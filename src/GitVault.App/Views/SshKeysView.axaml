<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.SshKeysView">
  <DockPanel>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <!-- Row actions sit under the grid, the way a classic list view puts its verbs. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="5" Margin="0,7,0,0">
      <Button Command="{Binding CopyPublicKeyCommand}" Content="{loc:Tr Keys_CopyPublicKey}" />
      <Button Command="{Binding CopyFingerprintCommand}" Content="{loc:Tr Keys_CopyFingerprint}" />
      <Button Command="{Binding RevealInFileManagerCommand}" Content="{loc:Tr Keys_RevealInFileManager}" />
      <TextBlock VerticalAlignment="Center"
                 Classes="dim"
                 IsVisible="{Binding ShowCopyConfirmation}"
                 Text="{loc:Tr Keys_Copied}" />
    </StackPanel>

    <DataGrid Name="KeysGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Keys_Column_Path}" Binding="{Binding Path}" Width="2*" />
        <DataGridTextColumn Header="{loc:Tr Keys_Column_Algorithm}" Binding="{Binding Algorithm}" Width="110" />
        <DataGridTextColumn Header="{loc:Tr Keys_Column_Bits}" Binding="{Binding Bits}" Width="70" />
        <DataGridTextColumn Header="{loc:Tr Keys_Column_Fingerprint}" Binding="{Binding Fingerprint}" Width="3*" />
        <DataGridTextColumn Header="{loc:Tr Keys_Column_Format}" Binding="{Binding Format}" Width="110" />
        <DataGridTextColumn Header="{loc:Tr Keys_Column_Protection}" Binding="{Binding Protection}" Width="130" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
