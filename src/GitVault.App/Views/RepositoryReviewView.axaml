<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.RepositoryReviewView">
  <StackPanel Spacing="0">

    <Border Classes="note warn" Margin="0,0,0,7">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <Image Classes="icon20" Source="{StaticResource IconSeverityMedium}" VerticalAlignment="Top" />
        <StackPanel Spacing="2" MaxWidth="540">
          <TextBlock FontWeight="Bold" Text="{Binding NothingWrittenCaption}" TextWrapping="Wrap" />
          <TextBlock Classes="dim" TextWrapping="Wrap" Text="{loc:Tr Dialog_ReviewBeforeApply}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto" Margin="0,0,0,7">
      <TextBlock Grid.Column="0" Classes="dim" Text="{loc:Tr Profiles_Repository}" />
      <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding RepositoryPath}" />
    </Grid>

    <TextBlock Classes="sectionHeader" Text="{loc:Tr Profiles_PlannedChanges}" />

    <Border Classes="diff">
      <!-- A diff line is not wrapped, so it needs somewhere to go when it is longer than the
           dialog. Scrolling it here keeps the rest of the dialog at the dialog's own width. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Lines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Classes="mono"
                       Classes.added="{Binding IsAddition}"
                       Classes.removed="{Binding IsRemoval}"
                       Text="{Binding Text}"
                       TextWrapping="NoWrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- A warning is something the user may not want; a blocker is something they cannot do. -->
    <Border Classes="note warn" IsVisible="{Binding HasWarnings}">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <Image Classes="icon20" Source="{StaticResource IconSeverityMedium}" VerticalAlignment="Top" />
        <StackPanel Spacing="2" MaxWidth="540">
          <TextBlock FontWeight="Bold" Text="{loc:Tr Dialog_PlanWarnings}" />
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="note" IsVisible="{Binding HasBackup}">
      <StackPanel Spacing="3" MaxWidth="560">
        <TextBlock TextWrapping="Wrap" Text="{Binding BackupExplainsCaption}" />
        <SelectableTextBlock Classes="mono" Text="{Binding BackedUpRefs}" />
      </StackPanel>
    </Border>

    <Border Classes="note error" IsVisible="{Binding HasBlockers}">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <Image Classes="icon20" Source="{StaticResource IconSeverityHigh}" VerticalAlignment="Top" />
        <StackPanel Spacing="2" MaxWidth="540">
          <TextBlock FontWeight="Bold" Text="{loc:Tr Dialog_PlanBlocked}" />
          <ItemsControl ItemsSource="{Binding Blockers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
