<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.RepositoriesView">
  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="0,0,0,6">
      <Button Command="{Binding ScanCommand}"
              IsEnabled="{Binding !IsScanning}"
              Content="{loc:Tr Repositories_Scan}" />
      <TextBlock VerticalAlignment="Center"
                 IsVisible="{Binding IsScanning}"
                 Text="{loc:Tr Repositories_Scanning}" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="note" Margin="0,0,0,6"
            IsVisible="{Binding HasNoRoots}">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoRootsCaption}" />
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <DataGrid Name="RepositoriesGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRepository, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Repositories_Column_Name}" Binding="{Binding Name}" Width="180" />
        <DataGridTextColumn Header="{loc:Tr Repositories_Column_EffectiveIdentity}" Binding="{Binding EffectiveIdentity}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Repositories_Column_Remote}" Binding="{Binding RemoteUrl}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Repositories_Column_Path}" Binding="{Binding Path}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
