<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.IdentitiesView">
  <DockPanel>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <!-- Which identity actually wins, which is the question this page exists to answer. -->
    <Border DockPanel.Dock="Bottom" Classes="group" MaxHeight="190">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Margin="0,-16,0,4"
                   Text="{loc:Tr Identities_Effective_Title}" />
        <Border Classes="panelWhite">
          <DataGrid ItemsSource="{Binding EffectiveSettings}" BorderThickness="0" MaxHeight="140">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Tr Identities_Effective_Key}" Binding="{Binding Key}" Width="180" />
              <DataGridTextColumn Header="{loc:Tr Identities_Effective_Value}" Binding="{Binding Value}" Width="*" />
              <DataGridTextColumn Header="{loc:Tr Identities_Effective_WinningScope}" Binding="{Binding Scope}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </Border>

    <DataGrid Name="IdentitiesGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Identities_Column_Name}" Binding="{Binding UserName}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Identities_Column_Email}" Binding="{Binding Email}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Identities_Column_Source}" Binding="{Binding Source}" Width="150" />
        <DataGridTextColumn Header="{loc:Tr Identities_Column_Hosts}" Binding="{Binding Hosts}" Width="180" />
        <DataGridTextColumn Header="{loc:Tr Identities_Column_Confidence}" Binding="{Binding Confidence}" Width="110" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
