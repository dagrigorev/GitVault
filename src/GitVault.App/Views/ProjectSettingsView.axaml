<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.ProjectSettingsView">
  <ScrollViewer>
    <StackPanel Spacing="0">

      <Border Classes="note" IsVisible="{Binding !HasRepository}">
        <TextBlock TextWrapping="Wrap" Text="{Binding NoRepositoryCaption}" />
      </Border>

      <Border Classes="group" IsVisible="{Binding HasRepository}">
        <StackPanel>
          <TextBlock Classes="groupTitle" Margin="0,-16,0,4" Text="{loc:Tr Project_Group_Repository}" />

          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="dim" Margin="0,3"
                       Text="{loc:Tr Repositories_Column_Name}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,3" FontWeight="Bold"
                       Text="{Binding RepositoryName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="dim" Margin="0,3"
                       Text="{loc:Tr Keys_Column_Path}" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Margin="0,3"
                                 TextWrapping="Wrap" Text="{Binding RepositoryPath}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="group" IsVisible="{Binding HasRepository}">
        <StackPanel>
          <TextBlock Classes="groupTitle" Margin="0,-16,0,4" Text="{loc:Tr Project_Group_Settings}" />

          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,3"
                       Text="{loc:Tr Project_Field_Profile}" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" HorizontalAlignment="Stretch"
                      Name="ProfileBox"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,3"
                       Text="{loc:Tr Project_Field_Key}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding KeyChoices}"
                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,3"
                       Text="{loc:Tr Project_Field_Helper}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Helpers}"
                      SelectedItem="{Binding SelectedHelper, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,3"
                       Text="{loc:Tr Project_Field_Note}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                     Classes="multiline"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Note, Mode=TwoWay}" />

            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,5,0,0"
                      IsChecked="{Binding ExcludeFromScans, Mode=TwoWay}"
                      Content="{loc:Tr Project_Field_Exclude}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,8,0,0">
            <Button Classes="primary" Name="SaveProjectButton"
                    Command="{Binding SaveCommand}" Content="{loc:Tr Common_Save}" />
            <Button Command="{Binding RevertCommand}" Content="{loc:Tr Common_Revert}" />
            <Button Classes="danger" Command="{Binding ClearCommand}" Content="{loc:Tr Project_Clear}" />
            <Border Classes="badge warn" VerticalAlignment="Center" IsVisible="{Binding IsDirty}">
              <TextBlock Text="{loc:Tr Profiles_UnsavedChanges}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="note" IsVisible="{Binding HasRepository}">
        <TextBlock TextWrapping="Wrap" Text="{Binding StorageNoteCaption}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
