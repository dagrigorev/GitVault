<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.DashboardView">
  <ScrollViewer>
    <StackPanel Spacing="0">

      <TextBlock Classes="pageSubtitle"
                 IsVisible="{Binding HasNoScan}"
                 Text="{Binding NoScanCaption}" />

      <!-- Four counters, compact and bordered. Not a dashboard of tiles. -->
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="summaryCard" Margin="0,0,7,0">
              <StackPanel Spacing="0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Classes="icon16"
                         Source="{Binding IconKey, Converter={x:Static loc:IconLookupConverter.Instance}}" />
                  <TextBlock Classes="dim" Text="{Binding Caption}" />
                </StackPanel>
                <TextBlock Classes="cardNumber" Text="{Binding Count}" />
                <TextBlock Classes="dim" Text="{Binding CountCaption}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="dim" Margin="0,6,0,0" Text="{Binding ScanDurationCaption}" />

      <!-- The single most useful fact on the page: which identity actually wins. -->
      <Border Classes="group" IsVisible="{Binding HasEffectiveSettings}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Margin="0,-16,0,4"
                     Text="{loc:Tr Dashboard_Group_Effective}" />
          <Border Classes="panelWhite">
            <DataGrid ItemsSource="{Binding EffectiveSettings}" BorderThickness="0" MaxHeight="160">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr Identities_Effective_Key}" Binding="{Binding Key}" Width="200" />
                <DataGridTextColumn Header="{loc:Tr Identities_Effective_Value}" Binding="{Binding Value}" Width="*" />
                <DataGridTextColumn Header="{loc:Tr Identities_Effective_WinningScope}" Binding="{Binding Scope}" Width="160" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </Border>

      <Border Classes="group">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Margin="0,-16,0,4"
                     Text="{loc:Tr Dashboard_Group_Attention}" />

          <TextBlock DockPanel.Dock="Top" Classes="dim" Margin="0,0,0,5"
                     Text="{Binding WarningCountCaption}" />

          <Border Classes="panelWhite">
            <ListBox ItemsSource="{Binding Warnings}"
                     SelectedItem="{Binding SelectedWarning, Mode=TwoWay}"
                     BorderThickness="0"
                     MaxHeight="220">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
                    <Image Classes="icon16" VerticalAlignment="Top"
                           Source="{Binding Severity, Converter={x:Static loc:SeverityIconConverter.Instance}}" />
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Classes="mono dim" Text="{Binding Subject}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </Border>

      <Border Classes="note" IsVisible="{Binding SelectedWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock TextWrapping="Wrap" Text="{Binding SelectedWarning.Body}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
