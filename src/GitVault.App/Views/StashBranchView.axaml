<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.StashBranchView">
  <StackPanel Spacing="0">

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto">
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{loc:Tr Stashes_Field_Branch}" />
      <TextBox Grid.Column="1" Text="{Binding Branch, Mode=TwoWay}"
               AutomationProperties.Name="{loc:Tr Stashes_Field_Branch}" />
    </Grid>

    <Border Classes="note warn">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoteCaption}" />
    </Border>

  </StackPanel>
</UserControl>
