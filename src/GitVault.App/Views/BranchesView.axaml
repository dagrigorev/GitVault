<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.BranchesView">
  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="note" Margin="0,0,0,6"
            IsVisible="{Binding !HasRepository}">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoRepositoryCaption}" />
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="0,0,0,6"
                IsVisible="{Binding HasRepository}">
      <Button Name="CreateBranchButton" Command="{Binding CreateCommand}" Content="{loc:Tr Branches_Create}" />
      <Button Command="{Binding RenameCommand}"
              IsEnabled="{Binding CanEditSelection}" Content="{loc:Tr Branches_Rename}" />
      <Button Command="{Binding SetUpstreamCommand}"
              IsEnabled="{Binding CanEditSelection}" Content="{loc:Tr Branches_SetUpstream}" />
      <Button Classes="danger" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding CanDeleteSelection}" Content="{loc:Tr Common_Remove}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Classes="note" Margin="0,7,0,0">
      <TextBlock TextWrapping="Wrap" Text="{Binding BackupNoteCaption}" />
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <DataGrid Name="BranchesGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Branches_Column_Name}" Binding="{Binding Name}"
                            Width="*" MinWidth="170" />
        <DataGridTextColumn Header="{loc:Tr Branches_Column_Kind}" Binding="{Binding Kind}"
                            Width="Auto" MinWidth="130" />
        <DataGridTextColumn Header="{loc:Tr Branches_Column_Upstream}" Binding="{Binding Upstream}"
                            Width="*" MinWidth="150" />
        <DataGridTextColumn Header="{loc:Tr Branches_Column_Tracking}" Binding="{Binding Tracking}"
                            Width="Auto" MinWidth="130" />
        <DataGridTextColumn Header="{loc:Tr Branches_Column_Tip}" Binding="{Binding Tip}"
                            Width="Auto" MinWidth="80" />
        <DataGridTextColumn Header="{loc:Tr Branches_Column_Subject}" Binding="{Binding Subject}"
                            Width="2*" MinWidth="200" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
