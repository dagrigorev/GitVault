<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitVault.App.Views.DialogWindow"
        Classes="classicDialog"
        Title="{Binding DialogTitle}"
        Icon="avares://GitVault/Assets/gitvault.ico"
        Width="{Binding DialogWidth}"
        Height="{Binding DialogHeight}"
        FontFamily="{StaticResource ClassicFontFamily}"
        FontSize="{StaticResource ClassicFontSize}"
        Background="{StaticResource ClassicFaceBrush}"
        CanResize="True">

  <!--
    One frame for every dialog: caption band, body, footer. The body is resolved from the view
    model by the same locator the pages use, so adding a dialog means adding a view model and a
    small UserControl and nothing else.
  -->
  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="dialogTitle">
      <TextBlock Text="{Binding DialogTitle}" />
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Name="CancelButton"
                Content="{Binding CancelCaption}"
                IsVisible="{Binding ShowCancel}"
                IsCancel="True"
                MinWidth="88"
                Command="{Binding CancelCommand}" />
        <Button Name="ConfirmButton"
                Classes="primary"
                Content="{Binding ConfirmCaption}"
                IsDefault="True"
                MinWidth="88"
                IsEnabled="{Binding CanConfirm}"
                Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </Border>

    <!--
      Vertical only, deliberately. Allowing horizontal scrolling here measures the body against
      infinite width, so a star-sized column stops meaning "the space that is left" and starts
      meaning "as wide as the longest value in it" — which pushed the field labels off the side of
      the dialog. Anything that genuinely needs more width than the dialog has, such as a diff,
      carries its own scroller.
    -->
    <ScrollViewer Padding="10"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ContentControl Content="{Binding}" />
    </ScrollViewer>

  </DockPanel>
</Window>
