<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.LogsView">
  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="0,0,0,6">
      <TextBox Width="280"
               Watermark="{loc:Tr Logs_Filter}"
               Text="{Binding Filter, Mode=TwoWay}"
               AutomationProperties.Name="{loc:Tr Logs_Filter}" />
      <Button Command="{Binding ClearViewCommand}" Content="{loc:Tr Logs_Clear}" />
    </StackPanel>

    <DataGrid Name="LogsGrid"
              ItemsSource="{Binding Lines}"
              SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
              CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Logs_Column_Time}"
                            Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                            Width="110" />
        <DataGridTextColumn Header="{loc:Tr Logs_Column_Level}" Binding="{Binding Level}" Width="100" />
        <DataGridTextColumn Header="{loc:Tr Logs_Column_Message}" Binding="{Binding Message}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
