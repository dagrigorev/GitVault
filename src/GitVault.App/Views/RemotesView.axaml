<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.RemotesView">
  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="note" Margin="0,0,0,6"
            IsVisible="{Binding !HasRepository}">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoRepositoryCaption}" />
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="0,0,0,6"
                IsVisible="{Binding HasRepository}">
      <Button Name="AddRemoteButton" Command="{Binding AddCommand}" Content="{loc:Tr Common_Add}" />
      <Button Command="{Binding EditCommand}"
              IsEnabled="{Binding HasSelectedRemote}" Content="{loc:Tr Common_Edit}" />
      <Button Classes="danger" Command="{Binding RemoveCommand}"
              IsEnabled="{Binding HasSelectedRemote}" Content="{loc:Tr Common_Remove}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Classes="note" Margin="0,7,0,0">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoNetworkCaption}" />
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <DataGrid Name="RemotesGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Remotes_Column_Name}" Binding="{Binding Name}"
                            Width="Auto" MinWidth="140" />
        <DataGridTextColumn Header="{loc:Tr Remotes_Column_FetchUrl}" Binding="{Binding FetchUrl}"
                            Width="*" MinWidth="220" />
        <DataGridTextColumn Header="{loc:Tr Remotes_Column_PushUrl}" Binding="{Binding PushUrl}"
                            Width="*" MinWidth="220" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
