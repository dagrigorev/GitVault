<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.ClientsView">
  <DockPanel>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="5" Margin="0,7,0,0">
      <Button Command="{Binding OpenConfigFolderCommand}" Content="{loc:Tr Clients_OpenConfigFolder}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Classes="group"
            IsVisible="{Binding SelectedClient.HasBoundKeys}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Margin="0,-16,0,4"
                   Text="{loc:Tr Clients_BoundKeys}" />
        <Border Classes="panelWhite" MaxHeight="130">
          <DataGrid ItemsSource="{Binding SelectedClient.BoundKeys}" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Tr Clients_Column_Client}" Binding="{Binding Remote}" Width="200" />
              <DataGridTextColumn Header="{loc:Tr Keys_Column_Path}" Binding="{Binding KeyFile}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </Border>

    <DataGrid Name="ClientsGrid"
              ItemsSource="{Binding Cards}"
              SelectedItem="{Binding SelectedClient, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Clients_Column_Client}" Binding="{Binding Name}" Width="200" />
        <DataGridTextColumn Header="{loc:Tr Clients_Column_Version}" Binding="{Binding Version}" Width="120" />
        <DataGridTextColumn Header="{loc:Tr Clients_InstallPath}" Binding="{Binding InstallPath}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Clients_Accounts}" Binding="{Binding CredentialCountCaption}" Width="150" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
