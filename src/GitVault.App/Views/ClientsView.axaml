<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.ClientsView">
  <StackPanel Spacing="8">

    <TextBlock Classes="pageSubtitle"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <ListBox ItemsSource="{Binding Cards}"
             SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
             IsVisible="{Binding !IsEmpty}"
             MaxHeight="220">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Spacing="2" Margin="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Version}" Opacity="0.7" />
            </StackPanel>
            <TextBlock Opacity="0.7" FontSize="12" Text="{Binding CredentialCountCaption}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Classes="card"
            IsVisible="{Binding SelectedClient, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">

        <TextBlock TextWrapping="Wrap"
                   IsVisible="{Binding SelectedClient.IsOpaque}"
                   Text="{Binding SelectedClient.OpaqueCaption}" />

        <TextBlock Classes="sectionHeader" Margin="0,0,0,2" Text="{loc:Tr Clients_InstallPath}" />
        <TextBlock Classes="mono" Text="{Binding SelectedClient.InstallPath}" />

        <TextBlock Classes="sectionHeader" Text="{loc:Tr Clients_ConfigRoots}" />
        <TextBlock Classes="mono" Text="{Binding SelectedClient.ConfigRoots}" />

        <TextBlock Classes="sectionHeader" Text="{loc:Tr Clients_Accounts}" />
        <ItemsControl ItemsSource="{Binding SelectedClient.Accounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding SelectedClient.HasBoundKeys}" Spacing="4">
          <TextBlock Classes="sectionHeader" Text="{loc:Tr Clients_BoundKeys}" />
          <ItemsControl ItemsSource="{Binding SelectedClient.BoundKeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="160,*">
                  <TextBlock Grid.Column="0" Text="{Binding Remote}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding KeyFile}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="sectionHeader" Text="{loc:Tr Clients_SshCommand}" />
          <TextBlock Classes="mono" Text="{Binding SelectedClient.SshExecutable}" />
        </StackPanel>

        <Button Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Command="{Binding OpenConfigFolderCommand}"
                >
          <StackPanel Orientation="Horizontal">
            <PathIcon Classes="buttonIcon" Data="{StaticResource IconFolderOpen}" />
            <TextBlock Text="{loc:Tr Clients_OpenConfigFolder}" />
          </StackPanel>
        </Button>

      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
