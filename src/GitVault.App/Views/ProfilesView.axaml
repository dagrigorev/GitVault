<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.ProfilesView">
  <StackPanel Spacing="8">

    <TextBlock Classes="pageSubtitle"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <DataGrid ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
              IsVisible="{Binding !IsEmpty}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              MaxHeight="200">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Profiles_Column_Name}" Binding="{Binding Name}" Width="Auto" />
        <DataGridTextColumn Header="{loc:Tr Profiles_Column_Identity}" Binding="{Binding Identity}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Profiles_Column_Helper}" Binding="{Binding CredentialHelper}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Classes="card"
            IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">

        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Scopes}"
                    SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                    MinWidth="220"
                    AutomationProperties.Name="{loc:Tr Profiles_Column_Name}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBox Width="280"
                   Text="{Binding RepositoryPath, Mode=TwoWay}"
                   Watermark="{loc:Tr Repositories_Column_Path}"
                   AutomationProperties.Name="{loc:Tr Repositories_Column_Path}" />
        </StackPanel>

        <TextBlock Classes="pageSubtitle" Text="{Binding DryRunCaption}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding PreviewActivationCommand}" >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconPreview}" />
              <TextBlock Text="{loc:Tr Profiles_Activate_Button}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding PreviewDeactivationCommand}" >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconPreview}" />
              <TextBlock Text="{loc:Tr Profiles_Deactivate_Button}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding CanApply}"
                  >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconApply}" />
              <TextBlock Text="{loc:Tr Common_Apply}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding RollbackCommand}"
                  IsEnabled="{Binding CanRollback}"
                  >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconRollback}" />
              <TextBlock Text="{loc:Tr Profiles_Rollback}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding StatusMessage}" />

        <StackPanel IsVisible="{Binding PlanDiff, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Spacing="4">
          <TextBlock Classes="sectionHeader" Text="{loc:Tr Profiles_PlannedChanges}" />
          <SelectableTextBlock Classes="mono" Text="{Binding PlanDiff}" />
        </StackPanel>

      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
