<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.CredentialsView">
  <DockPanel>

    <CheckBox DockPanel.Dock="Top" Margin="0,0,0,6"
              IsChecked="{Binding ShowAll, Mode=TwoWay}"
              Content="{loc:Tr Credentials_ShowAll}" />

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <!--
      Revealing a secret is a separate, confirmed and time-limited action. It lives under the
      grid rather than in the properties pane so that nothing about selecting a row can put a
      secret on screen.
    -->
    <Border DockPanel.Dock="Bottom" Classes="group"
            IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Margin="0,-16,0,4"
                   Text="{loc:Tr Credentials_Detail_SecretValue}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
          <Button Command="{Binding RevealCommand}" Content="{loc:Tr Credentials_Reveal}" />
          <Button Command="{Binding HideSecretCommand}"
                  IsVisible="{Binding IsSecretVisible}"
                  Content="{loc:Tr Credentials_Hide}" />
          <Button Command="{Binding CopySecretCommand}"
                  IsVisible="{Binding IsSecretVisible}"
                  Content="{loc:Tr Credentials_CopySecret}" />
          <Border Classes="badge warn" VerticalAlignment="Center"
                  IsVisible="{Binding SelectedRow.IsPlaintext}">
            <TextBlock Text="{loc:Tr Credentials_PlaintextBadge}" />
          </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   IsVisible="{Binding RevealConfirmationPending}"
                   Text="{loc:Tr Credentials_RevealConfirm}" />

        <StackPanel IsVisible="{Binding IsSecretVisible}" Spacing="3" Margin="0,6,0,0">
          <Border Classes="panelWhite" Padding="6">
            <SelectableTextBlock Classes="mono" Text="{Binding RevealedSecret}" />
          </Border>
          <TextBlock Classes="dim" Text="{Binding HidingInCaption}" />
          <TextBlock Classes="dim" TextWrapping="Wrap" Text="{loc:Tr Credentials_ClipboardNote}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DataGrid Name="CredentialsGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Vault}" Binding="{Binding Vault}" Width="170" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Host}" Binding="{Binding Host}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Protocol}" Binding="{Binding Protocol}" Width="80" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_UserName}" Binding="{Binding UserName}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Client}" Binding="{Binding OwningClient}" Width="140" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_LastWrite}" Binding="{Binding LastWrite}" Width="130" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
