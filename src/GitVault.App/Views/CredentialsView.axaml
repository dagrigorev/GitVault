<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.CredentialsView">
  <StackPanel Spacing="6">

    <CheckBox IsChecked="{Binding ShowAll, Mode=TwoWay}" Content="{loc:Tr Credentials_ShowAll}" />

    <TextBlock Classes="pageSubtitle"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <DataGrid ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
              IsVisible="{Binding !IsEmpty}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              MinHeight="180"
              MaxHeight="340">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Host}" Binding="{Binding Host}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_UserName}" Binding="{Binding UserName}" Width="Auto" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Protocol}" Binding="{Binding Protocol}" Width="Auto" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Vault}" Binding="{Binding Vault}" Width="Auto" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_Client}" Binding="{Binding OwningClient}" Width="Auto" />
        <DataGridTextColumn Header="{loc:Tr Credentials_Column_LastWrite}" Binding="{Binding LastWrite}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Classes="card"
            Margin="0,12,0,0"
            IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">

        <TextBlock Classes="sectionHeader" Margin="0,0,0,4" Text="{loc:Tr Common_Details}" />

        <TextBlock Classes="mono" Text="{Binding SelectedRow.Target}" />

        <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   IsVisible="{Binding SelectedRow.IsPlaintext}"
                   Text="{loc:Tr Credentials_PlaintextBadge}" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Command="{Binding RevealCommand}" >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconReveal}" />
              <TextBlock Text="{loc:Tr Credentials_Reveal}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding HideSecretCommand}"
                  IsVisible="{Binding IsSecretVisible}"
                  >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconHide}" />
              <TextBlock Text="{loc:Tr Credentials_Hide}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding CopySecretCommand}"
                  IsVisible="{Binding IsSecretVisible}"
                  >
            <StackPanel Orientation="Horizontal">
              <PathIcon Classes="buttonIcon" Data="{StaticResource IconCopy}" />
              <TextBlock Text="{loc:Tr Credentials_CopySecret}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock IsVisible="{Binding RevealConfirmationPending}"
                   TextWrapping="Wrap"
                   Text="{loc:Tr Credentials_RevealConfirm}" />

        <StackPanel IsVisible="{Binding IsSecretVisible}" Spacing="4">
          <SelectableTextBlock Classes="mono" Text="{Binding RevealedSecret}" />
          <TextBlock Opacity="0.7" Text="{Binding HidingInCaption}" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{loc:Tr Credentials_ClipboardNote}" />
        </StackPanel>

      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
