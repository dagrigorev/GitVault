<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.AgentsView">
  <DockPanel>

    <TextBlock DockPanel.Dock="Top"
               Classes="pageSubtitle"
               Margin="0,0,0,6"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyCaption}" />

    <!-- Agents on top, the selected agent's keys below: a classic master-detail split. -->
    <DataGrid DockPanel.Dock="Top"
              Name="AgentsGrid"
              MaxHeight="130"
              ItemsSource="{Binding Cards}"
              SelectedItem="{Binding SelectedAgent, Mode=TwoWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Agents_Column_Agent}" Binding="{Binding KindCaption}" Width="220" />
        <DataGridTextColumn Header="{loc:Tr Agents_Column_State}" Binding="{Binding StateCaption}" Width="110" />
        <DataGridTextColumn Header="{loc:Tr Agents_Detail_Endpoint}" Binding="{Binding Endpoint}" Width="*" />
        <DataGridTextColumn Header="{loc:Tr Agents_LoadedKeys}" Binding="{Binding KeyCountCaption}" Width="130" />
      </DataGrid.Columns>
    </DataGrid>

    <Border DockPanel.Dock="Bottom" Classes="group"
            IsVisible="{Binding SelectedAgent, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Margin="0,-16,0,4"
                   Text="{loc:Tr Agents_ShellSnippet}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5">
          <ComboBox ItemsSource="{Binding SelectedAgent.Shells}"
                    SelectedItem="{Binding SelectedAgent.SelectedShell, Mode=TwoWay}"
                    MinWidth="140"
                    AutomationProperties.Name="{loc:Tr Agents_Shell}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Command="{Binding CopySnippetCommand}" Content="{loc:Tr Agents_CopySnippet}" />
        </StackPanel>

        <Border Classes="panelWhite" Padding="6" Margin="0,5,0,0">
          <SelectableTextBlock Classes="mono" Text="{Binding SelectedAgent.Snippet}" />
        </Border>
      </DockPanel>
    </Border>

    <DockPanel Margin="0,7,0,0"
               IsVisible="{Binding SelectedAgent, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="{loc:Tr Agents_LoadedKeys}" />

      <TextBlock DockPanel.Dock="Top"
                 Classes="dim"
                 TextWrapping="Wrap"
                 Margin="0,0,0,4"
                 IsVisible="{Binding SelectedAgent.IsReadOnly}"
                 Text="{loc:Tr Agents_ReadOnly}" />

      <!-- Removing every key is destructive, so it arms first and confirms in place. -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="5" Margin="0,6,0,0">
        <Button Classes="danger"
                Command="{Binding RemoveAllKeysCommand}"
                IsEnabled="{Binding !SelectedAgent.IsReadOnly}"
                Content="{loc:Tr Agents_RemoveAll}" />
        <TextBlock VerticalAlignment="Center"
                   IsVisible="{Binding SelectedAgent.RemoveAllArmed}"
                   Text="{loc:Tr Agents_RemoveAllConfirm}" />
      </StackPanel>

      <DataGrid ItemsSource="{Binding SelectedAgent.Keys}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Tr Agents_Column_Algorithm}" Binding="{Binding Algorithm}" Width="110" />
          <DataGridTextColumn Header="{loc:Tr Agents_Column_Fingerprint}" Binding="{Binding Fingerprint}" Width="*" />
          <DataGridTextColumn Header="{loc:Tr Agents_Column_Comment}" Binding="{Binding Comment}" Width="220" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

  </DockPanel>
</UserControl>
