<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.HooksView">
  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="note" Margin="0,0,0,6"
            IsVisible="{Binding !HasRepository}">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoRepositoryCaption}" />
    </Border>

    <!--
      Unconditional, and at the top. Every other editor in this application changes what git reads;
      this one changes what it executes, and that is true every time the page is opened.
    -->
    <Border DockPanel.Dock="Top" Classes="note error" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <Image Classes="icon20" Source="{StaticResource IconSeverityHigh}" VerticalAlignment="Top" />
        <TextBlock TextWrapping="Wrap" MaxWidth="640" Text="{Binding DangerCaption}" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="0,0,0,6"
                IsVisible="{Binding HasRepository}">
      <Button Name="EditHookButton" Command="{Binding EditCommand}"
              IsEnabled="{Binding HasSelectedHook}" Content="{loc:Tr Hooks_Edit}" />
      <Button Name="DeleteHookButton" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding CanDelete}" Content="{loc:Tr Hooks_Delete}" />
      <Button Name="RefreshHooksButton" Command="{Binding RefreshCommand}"
              Content="{loc:Tr Common_Refresh}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6"
                IsVisible="{Binding HasRepository}">
      <TextBlock Classes="dim" VerticalAlignment="Center" Text="{loc:Tr Hooks_Directory}" />
      <SelectableTextBlock Classes="mono" VerticalAlignment="Center" Text="{Binding Directory}" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="note warn" Margin="0,0,0,6"
            IsVisible="{Binding IsRedirected}">
      <TextBlock TextWrapping="Wrap" Text="{Binding RedirectedCaption}" />
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="note warn" Margin="0,7,0,0"
            IsVisible="{Binding SelectionIsInert}">
      <TextBlock TextWrapping="Wrap" Text="{Binding InertCaption}" />
    </Border>

    <DataGrid Name="HooksGrid"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
              CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Tr Hooks_Column_Name}" Binding="{Binding Name}"
                            Width="*" MinWidth="200" />
        <DataGridTextColumn Header="{loc:Tr Hooks_Column_State}" Binding="{Binding State}"
                            Width="Auto" MinWidth="190" />
        <DataGridTextColumn Header="{loc:Tr Hooks_Column_Size}" Binding="{Binding Size}"
                            Width="Auto" MinWidth="100" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
