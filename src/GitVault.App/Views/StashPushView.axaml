<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.StashPushView">
  <StackPanel Spacing="0">

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto">
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{loc:Tr Stashes_Field_Message}" />
      <TextBox Grid.Column="1" Text="{Binding Message, Mode=TwoWay}"
               AutomationProperties.Name="{loc:Tr Stashes_Field_Message}" />
    </Grid>

    <CheckBox Margin="0,8,0,0" IsChecked="{Binding IncludeUntracked, Mode=TwoWay}"
              Content="{loc:Tr Stashes_Field_Untracked}" />

    <Border Classes="note warn" IsVisible="{Binding IncludeUntracked}">
      <TextBlock TextWrapping="Wrap" Text="{Binding UntrackedCaption}" />
    </Border>

    <Border Classes="note">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoteCaption}" />
    </Border>

  </StackPanel>
</UserControl>
