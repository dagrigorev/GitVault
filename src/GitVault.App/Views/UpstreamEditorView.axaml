<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.UpstreamEditorView">
  <StackPanel Spacing="0">

    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="dim" Margin="0,4"
                 Text="{loc:Tr Branches_Column_Name}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="Bold"
                 Text="{Binding BranchName}" />

      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"
                 Text="{loc:Tr Branches_Column_Upstream}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Candidates}"
                SelectedItem="{Binding SelectedUpstream, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Border Classes="note" IsVisible="{Binding HasNoCandidates}">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoCandidatesCaption}" />
    </Border>

  </StackPanel>
</UserControl>
