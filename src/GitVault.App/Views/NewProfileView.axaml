<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GitVault.App.Markup"
             x:Class="GitVault.App.Views.NewProfileView">
  <StackPanel Spacing="0">

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"
                 Text="{loc:Tr Profiles_Field_Name}" />
      <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding ProfileName, Mode=TwoWay}" />

      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"
                 Text="{loc:Tr Profiles_Field_Identity}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Identities}"
                SelectedItem="{Binding SelectedIdentity, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Border Classes="note warn" IsVisible="{Binding HasNoIdentities}">
      <TextBlock TextWrapping="Wrap" Text="{Binding NoIdentitiesCaption}" />
    </Border>

  </StackPanel>
</UserControl>
