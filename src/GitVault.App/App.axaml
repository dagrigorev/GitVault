<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitVault.App"
             x:Class="GitVault.App.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Generated icon set; see build/generate-classic-icons.ps1. -->
        <ResourceInclude Source="avares://GitVault/Assets/ClassicIcons.axaml" />
        <!-- Every colour, brush and font the classic styles use. -->
        <ResourceInclude Source="avares://GitVault/Styles/ClassicPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <Thickness x:Key="PagePadding">7</Thickness>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!--
      The base themes still supply the control templates. The classic styles then override the
      parts of those templates that make a Fluent application look like one: radii, touch-sized
      padding, accent colours and shadows. Replacing every template outright would be far more
      code to audit, and would break on an Avalonia upgrade in ways a property setter does not.

      The variant is pinned to Light on this element: a Win32-era utility has one appearance, and
      a half-darkened version of it belongs to neither era.

      Avalonia's own FluentTheme rather than FluentAvalonia: nothing in the interface uses a
      FluentAvalonia control any more, and its icon font is a dependency the redesign no longer
      needs — one that the headless test platform cannot load at all.
    -->
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <StyleInclude Source="avares://GitVault/Styles/ClassicControls.axaml" />
    <StyleInclude Source="avares://GitVault/Styles/ClassicDataGrid.axaml" />
    <StyleInclude Source="avares://GitVault/Styles/ClassicChrome.axaml" />
  </Application.Styles>

</Application>
