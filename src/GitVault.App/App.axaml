<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:GitVault.App"
             x:Class="GitVault.App.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Generated icon set; see build/generate-icons.ps1. -->
        <ResourceInclude Source="avares://GitVault/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        Severity colours are defined here rather than borrowed from the theme's internal
        resource names, which are not a stable contract: a missing name resolves to null and the
        icon silently renders invisible. Both variants are given explicitly so the colours stay
        legible against either background.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SeverityHighBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="SeverityMediumBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="SeverityLowBrush" Color="#005FB8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SeverityHighBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="SeverityMediumBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="SeverityLowBrush" Color="#60CDFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!--
        Font fallback chain. The first entry is the platform default; the CJK families cover
        zh-Hans on Windows, macOS and Linux respectively. Avalonia walks the list until a
        family that has the glyph is found.
      -->
      <FontFamily x:Key="AppFontFamily">$Default, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Noto Sans SC, Source Han Sans SC</FontFamily>
      <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

      <Thickness x:Key="PagePadding">24</Thickness>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="True" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Icons inherit the foreground, so they follow the theme and any hover state. -->
    <Style Selector="PathIcon.navIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style Selector="PathIcon.buttonIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style Selector="PathIcon.titleIcon">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style Selector="PathIcon.cardIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="PathIcon.severityIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>

</Application>
