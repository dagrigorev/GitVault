<?xml version="1.0" encoding="utf-8"?>
<!--
  GitVault takes every package it uses from nuget.org and none from anywhere else.

  Without this file the machine-wide configuration decides, and a corporate mirror that does not
  carry the .NET runtime packs turns a self-contained publish into NU1301/NU1100 on
  Microsoft.NET.ILLink.Tasks and Microsoft.AspNetCore.App.Runtime.*. The source list is cleared
  rather than extended, and the mapping is restated here, because package source mapping is read
  from the nearest configuration file that defines it instead of being merged.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
